{
  "name": "clipcut",
  "version": "1.0.0",
  "description": "Fast desktop-style video editor: join clips, trim, speed, crop, text and captions, music. Copies streams instead of re-rendering whenever it can.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node test/smoke.js",
    "build": "pkg . -o dist/ClipCut.exe"
  },
  "license": "ISC",
  "dependencies": {
    "express": "^5.2.1"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "bin": "server.js",
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "dist"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.23.0"
  }
}
